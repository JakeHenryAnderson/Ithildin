FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_ITHILDIN_API_BASE_URL=http://127.0.0.1:8000
ENV VITE_ITHILDIN_API_BASE_URL=${VITE_ITHILDIN_API_BASE_URL}

COPY apps/ui/package.json apps/ui/package-lock.json ./
RUN npm ci

COPY deploy/nginx.conf /app/runtime/default.conf
COPY apps/ui ./
RUN npm run build \
    && chmod 0444 /app/runtime/default.conf \
    && chmod -R a+rX /app/dist \
    && test -x /app \
    && test -x /app/dist \
    && test -r /app/runtime/default.conf \
    && test -r /app/dist/index.html

FROM nginxinc/nginx-unprivileged:1.27-alpine

ARG ITHILDIN_IMAGE_VERSION=0.1.0-local
ARG ITHILDIN_SOURCE_REVISION=unknown

LABEL org.opencontainers.image.title="Ithildin Command Center" \
    org.opencontainers.image.version="${ITHILDIN_IMAGE_VERSION}" \
    org.opencontainers.image.revision="${ITHILDIN_SOURCE_REVISION}" \
    org.opencontainers.image.description="Operator presentation surface; Gateway remains authoritative"

COPY --from=build /app/runtime/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

RUN test -x /usr/share/nginx/html \
    && test -r /etc/nginx/conf.d/default.conf \
    && test -r /usr/share/nginx/html/index.html

EXPOSE 8080
