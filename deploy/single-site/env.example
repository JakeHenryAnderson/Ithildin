# Copy to an absolute path outside the repository, replace every placeholder, and chmod 0600.
ITHILDIN_E1_SITE_ID=replace-with-site-id
ITHILDIN_E1_VERSION=0.1.0-e1
ITHILDIN_E1_SOURCE_REVISION=replace-with-40-lowercase-hex-commit
ITHILDIN_E1_API_PORT=8000
ITHILDIN_E1_UI_PORT=5173
ITHILDIN_E1_DATA_ROOT=/replace/with/absolute/ithildin-e1-data-root
ITHILDIN_E1_RUNTIME_INVENTORY_PATH=/replace/with/absolute/runtime-candidate-inventory.json
ITHILDIN_E1_RUNTIME_AUTHORITY_PATH=/replace/with/absolute/api-candidate.json
ITHILDIN_ADMIN_TOKEN=replace-with-at-least-32-random-characters
ITHILDIN_CONTAINER_UID=10001
ITHILDIN_CONTAINER_GID=10001
