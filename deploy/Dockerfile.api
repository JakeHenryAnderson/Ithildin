FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY apps ./apps
COPY packages ./packages
COPY trusted-hosts ./trusted-hosts

RUN uv sync --frozen --no-dev \
    && chmod -R a+rX /app/.venv /app/apps /app/packages \
    && groupadd --gid 10001 ithildin \
    && useradd --uid 10001 --gid ithildin --home-dir /app --no-create-home ithildin \
    && mkdir -p /app/var/db /app/var/logs /app/workspaces /tmp/ithildin \
    && chown -R 10001:10001 /app/var /app/workspaces /tmp/ithildin

USER 10001:10001

RUN test -x /app \
    && test -x /app/.venv \
    && test -x /app/.venv/bin \
    && test -x /app/apps \
    && test -x /app/apps/api \
    && test -x /app/.venv/bin/python \
    && test -r /app/apps/api/verified_launch.py \
    && test -r /app/apps/api/src/ithildin_api/app.py

EXPOSE 8000

CMD ["python", "apps/api/verified_launch.py"]
